rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Contenido público del portafolio: lectura libre.
    // Escritura solo si el usuario (anónimo) ya desbloqueó con el PIN correcto.
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/unlock/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['version', 'profile', 'experience', 'projects']);
    }

    // Hash del PIN. Nadie lo lee desde el cliente; solo las reglas vía get().
    match /config/{docId} {
      allow read, write: if false;
    }

    // Desbloqueo: cada uid solo puede crear su propio documento y únicamente
    // si sha256(pin) coincide con config/admin.pinHash.
    match /unlock/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.pin is string
        && hashing.sha256(request.resource.data.pin).toHexString().lower()
           == get(/databases/$(database)/documents/config/admin).data.pinHash;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
