# Copia este archivo a .env y rellena con tu proyecto de Firebase (Consola > Configuración del proyecto > Tus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# PIN del panel /admin (4-8 dígitos). Se valida en cliente y se exige en las reglas de Firestore.
VITE_ADMIN_PIN=2468
